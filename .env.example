# ==========================================================
# قالب متغيّرات البيئة — انسخه إلى .env (محلياً) أو .env.production (على السيرفر)
#   cp .env.example .env
# لا ترفع الملف الحقيقي إلى Git.
# ==========================================================

# ---------- وقت البناء (يُحقن في المتصفح — لا تضع أسراراً هنا) ----------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# ---------- وقت التشغيل (السيرفر فقط) ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# سرّي: يتجاوز صلاحيات RLS — يُستخدم داخل السيرفر فقط (مطلوب للوحة /dashboard والتتبّع)
SUPABASE_SERVICE_ROLE_KEY=

# دخول لوحة التحكم /dashboard
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- اختياري ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# هدف البناء لـ Nitro: node-server | vercel | netlify | cloudflare-module
NITRO_PRESET=node-server
